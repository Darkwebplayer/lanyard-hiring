# drizzle-kit + tests
NEON_POSTGRES_DB=postgres://...
# wrangler dev: local Hyperdrive target (same db as above in dev)
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://...

ADMIN_EMAIL=you@gmail.com
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8799
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SECRET=
DISABLED_NODE_TYPES=
# AI: Gemini for text (summaries, Ask, flow drafts); Clairic and Clef come from the AI binding in wrangler.jsonc. Or AI_MOCK=1 for a deterministic dev mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash
AI_MOCK=
# pnpm test:pg: a separate database on the same server (created if missing, emptied every run)
TEST_PG_URL=postgres://.../hiring_test
